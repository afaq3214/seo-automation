# Password for the whole app (the public blog API /api/v1 stays open). REQUIRED in production.
APP_PASSWORD=

# Supabase (server-side only — never expose the service role key to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — business analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Crawler
CRAWL_MAX_PAGES=25
# Full-site crawl: max pages per project, and pages crawled per batch request
CRAWL_MAX_SITE_PAGES=1000
CRAWL_BATCH_SIZE=20
# Set to true only where a Chromium binary is installed (npx playwright install chromium)
ENABLE_PLAYWRIGHT=false

# ---- Module 02: keyword research ----
# Keyword data provider:
#   serper     (default) Google autocomplete discovery via Serper — estimated demand, no volume/CPC
#   dataforseo Google Ads volume, competition and CPC (USD)
#   google_ads Google Ads API directly (needs Basic access)
KEYWORD_DATA_PROVIDER=serper
# Max autocomplete queries per research run (serper provider)
SERPER_DISCOVERY_MAX_QUERIES=120
# DataForSEO API login + API password (dashboard → API Access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Ads API (KeywordPlanIdeaService) — only for KEYWORD_DATA_PROVIDER=google_ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The Google Ads account to run keyword planning under (digits, dashes optional)
GOOGLE_ADS_CUSTOMER_ID=
# Only if that account is accessed through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Serper.dev — keyword discovery (serper provider) and SERP checks for Estimated SEO Difficulty
SERPER_API_KEY=

# Cost controls
# Keywords per run that get a SERP check (0-50)
SERP_CHECK_LIMIT=30
# Keywords kept per project after cleaning
KEYWORD_MAX_PER_PROJECT=2000
# Reuse research younger than this many days unless refreshed
KEYWORD_RESEARCH_TTL_DAYS=7

# ---- Module 03: competitor discovery ----
# Discovery searches per run (3-10)
COMPETITOR_MAX_QUERIES=8
# Candidate domains analyzed per run (5-20)
COMPETITOR_MAX_CANDIDATES=18
# Competitors kept (3-15)
COMPETITOR_MAX_FINAL=10
# Reuse discovery younger than this many days unless refreshed
COMPETITOR_TTL_DAYS=7
# Extra domains to ignore, comma-separated (added to the built-in list)
COMPETITOR_IGNORE_DOMAINS=

# ---- Module 04: content gap & SEO strategy ----
# Topics checked on Google for competitor rankings per run (uses cached SERPs where possible)
STRATEGY_MAX_TOPICS=25
# Opportunities kept in the strategy
STRATEGY_MAX_OPPORTUNITIES=20

# ---- Module 05: SERP brief & blog generation ----
# Top-ranking pages crawled for their outline per article (0-8)
ARTICLE_RESEARCH_PAGES=5
# Hard maximum article length in words (including FAQ)
ARTICLE_MAX_WORDS=2000

# ---- Module 08: featured images (OpenAI Image API -> Cloudflare R2) ----
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high (cost grows with quality)
OPENAI_IMAGE_QUALITY=medium
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://images.yourdomain.com
R2_PUBLIC_BASE_URL=

# ---- Module 09: quality targets + improvement loop ----
QUALITY_TARGET_SEO=90
QUALITY_TARGET_GEO=85
QUALITY_TARGET_AEO=90
QUALITY_MAX_ROUNDS=3
# Independent judge model for the AI-graded criteria (different from the writer model)
QUALITY_JUDGE_MODEL=claude-opus-5-5
# Judge runs for the final grade (median is used)
QUALITY_JUDGE_VOTES=3
